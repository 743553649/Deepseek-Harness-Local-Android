<?xml version="1.0" encoding="utf-8"?>
<!-- 对话页顶部的小胶囊：引擎未就绪时说明原因；预览模式时变成「← 主页」。
     这是唯一允许出现在对话页上的 App 元素（docs/UI-REDESIGN.md §4.5）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C7FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#C7FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#8AFFFFFF"
                android:startColor="#B8FFFFFF"
                android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
