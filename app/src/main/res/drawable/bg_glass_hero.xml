<?xml version="1.0" encoding="utf-8"?>
<!-- 引擎卡片（设置页的主角）：圆角 26dp，白 88%→62%，比普通玻璃面板更亮一档。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#CCFFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#9EFFFFFF"
                android:startColor="#E0FFFFFF"
                android:type="linear" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
