<?xml version="1.0" encoding="utf-8"?>
<!-- 底栏选中态：深色胶囊（圆角给超大值 = 自动取高度的一半，永远是个规规矩矩的胶囊）。
     之前是一块 18dp 圆角的大方块、离屏幕边缘只有 4dp，在白底栏上贴着屏幕左下/右下角很割裂；
     现在靠底栏的内边距把它缩成居中胶囊、四面都留出余量。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#CC12151A"
        android:startColor="#F012151A"
        android:type="linear" />
    <corners android:radius="999dp" />
</shape>
