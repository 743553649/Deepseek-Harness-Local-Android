<?xml version="1.0" encoding="utf-8"?>
<!-- 底栏选中态药丸：深色液体块，在几个格子间平移。
     铺满底栏后它是一块圆角方块（不再是小药丸），所以圆角收小一档。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#CC12151A"
        android:startColor="#F012151A"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
