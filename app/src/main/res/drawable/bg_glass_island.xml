<?xml version="1.0" encoding="utf-8"?>
<!-- 底部悬浮玻璃岛（174×45dp，docs/UI-REDESIGN.md §3.1）。
     真·模糊在 Android 上做不到（§4.3），观感靠 半透明 + 渐变 + 1dp 高光描边 + 柔影。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈 1dp 白描边：玻璃的边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C7FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#C7FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 内层：72%→54% 白竖渐变（angle=270 才是从上到下） -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#8AFFFFFF"
                android:startColor="#B8FFFFFF"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>

    <!-- 顶部 1dp 高光线 -->
    <item
        android:gravity="top"
        android:height="1dp"
        android:left="14dp"
        android:right="14dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
