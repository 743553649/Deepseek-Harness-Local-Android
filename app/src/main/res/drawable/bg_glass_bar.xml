<?xml version="1.0" encoding="utf-8"?>
<!-- 底栏玻璃：铺满、不留边距、直角（不是悬浮岛了）。
     透明比比第一版高：底下垫的东西能透上来，才看得出是液态玻璃材质。
     底下的"垫层"由 MainActivity 按页面切换（对话页=纯白，其它页=页面渐变）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃本体：44%→24% 白竖渐变（angle=270 才是从上到下） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#3DFFFFFF"
                android:startColor="#70FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 顶沿 1dp 高光：玻璃的边（在纯白底上几乎看不见，正好） -->
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
