<?xml version="1.0" encoding="utf-8"?>
<!--
  界面骨架（液态玻璃 + 常驻底部玻璃岛导航）。

  第 2 步（三页合一）：设置页与扩展中心不再是独立 Activity，而是本布局里的两个页面，
  和对话页（WebView）在同一个 Activity 里切换 —— 这样切页是真正的平滑过渡，底栏也常驻不动。

  分层：
    root
    ├─ 竖向 LinearLayout
    │   ├─ pageHost（weight=1，装三个页面，同一时刻只显示一个）
    │   │   ├─ chatPage（白底 + WebView）
    │   │   ├─ settingsPage / extensionsPage / aboutPage（include 进来的三个页面，透明底）
    │   │   ├─ loading（引擎就绪前的加载页：只盖对话页，不盖底栏，也不盖设置/扩展）
    │   └─ navArea（72dp 占位区，里面是铺满底栏的玻璃条；加载完成前整体隐藏）

  ⚠️ 底栏绝不能盖住网页的输入框（docs/UI-REDESIGN.md §4.2）：
    WebView 用 weight=1 自己变矮，底栏是它下面的兄弟节点，不是叠在它上面。
  ⚠️ navArea 默认透明，让根节点的页面渐变透过来（扩展/设置页要用）；
    对话页时由代码把它设成引擎网页底部的颜色（§4.2 的"无缝"，见 MainActivity）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ============ 页面一：对话（纯 WebView，不放任何 App 自己的东西） ============ -->
            <LinearLayout
                android:id="@+id/chatPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFFFF"
                android:orientation="vertical">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 加载页：引擎侧没就绪时盖住**对话页**；网页首帧渲染完成后淡出。
                 放在 chatPage 之后、两个 include 之前，且**不设 elevation** ——
                 FrameLayout 里后画的在上，这样设置/扩展页不会被启动画面盖住。 -->
            <LinearLayout
                android:id="@+id/loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_page"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:id="@+id/loadingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:paddingHorizontal="32dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <app.dsh.mobile.GlassSpinner
                    android:id="@+id/loadingSpinner"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="26dp" />

                <!-- 安装/解压进度（和转圈二选一）：null = 来回扫，有值 = 确定性百分比 -->
                <app.dsh.mobile.GlassProgress
                    android:id="@+id/installProgress"
                    android:layout_width="200dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="26dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============ 页面二 / 三：设置、扩展中心 ============ -->
            <include
                android:id="@+id/settingsPage"
                layout="@layout/view_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/extensionsPage"
                layout="@layout/view_extensions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/aboutPage"
                layout="@layout/view_about"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

        <!-- 底栏：铺满、直角、不留边距（不是悬浮岛了）。
             这一层是"垫色"：对话页由代码设成纯白（跟白色的网页连成一片），
             其它页透明 → 露出根节点的页面渐变；玻璃本体是里面的 navBar。 -->
        <FrameLayout
            android:id="@+id/navArea"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFFFF">

            <!-- 玻璃本体：透明 + 顶沿高光，铺满整条底栏 -->
            <FrameLayout
                android:id="@+id/navBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_bar"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <!-- 选中态药丸：宽度在代码里按玻璃条内容宽 / 格子数 算，别写死 dp -->
                <View
                    android:id="@+id/navPill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_nav_pill" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/navChat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navChatIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_chat" />

                        <TextView
                            android:id="@+id/navChatText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_chat"
                            android:textColor="@color/nav_off"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navExt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navExtIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_ext" />

                        <TextView
                            android:id="@+id/navExtText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_ext"
                            android:textColor="@color/nav_off"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navSettingsIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_settings" />

                        <TextView
                            android:id="@+id/navSettingsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_settings"
                            android:textColor="@color/nav_off"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navAbout"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navAboutIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_about" />

                        <TextView
                            android:id="@+id/navAboutText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_about"
                            android:textColor="@color/nav_off"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
