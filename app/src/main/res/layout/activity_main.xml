<?xml version="1.0" encoding="utf-8"?>
<!--
  界面骨架（液态玻璃 + 底部悬浮玻璃岛导航）。

  分层：
    root ├─ 竖向 LinearLayout
    │       ├─ WebView（weight=1）
    │       └─ navArea（72dp 纯白占位区，里面是悬浮玻璃岛）
    ├─ capsule（顶部小胶囊：引擎未就绪时说明原因 / 预览模式时变「← 主页」）
    └─ loading（引擎就绪前的加载页，覆盖层）

  ⚠️ 底栏绝不能盖住网页的输入框（docs/UI-REDESIGN.md §4.2）：
    - 用竖向 LinearLayout 让 WebView 自己变矮，**不要**用 FrameLayout 把岛叠在 WebView 上；
    - **不要**给 WebView 设 paddingBottom（padding 不改变网页视口，网页不会让位）；
    - 留白区底色必须是纯白，和网页白底连成一片，交界处不画任何线 —— 「无缝」的全部秘密。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底栏占位区：72dp（含底部 14dp 间距） -->
        <FrameLayout
            android:id="@+id/navArea"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#FFFFFFFF"
            android:clipChildren="false">

            <!-- 悬浮玻璃岛：174×45dp，圆角 24dp -->
            <FrameLayout
                android:id="@+id/navIsland"
                android:layout_width="174dp"
                android:layout_height="45dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_glass_island"
                android:clipChildren="false"
                android:elevation="12dp"
                android:padding="3dp">

                <!-- 选中态药丸：宽度在代码里按岛内容宽 / 3 算，别写死 dp -->
                <View
                    android:id="@+id/navPill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_nav_pill" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/navChat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navChatIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_chat" />

                        <TextView
                            android:id="@+id/navChatText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_chat"
                            android:textColor="#FF7A8292"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navExt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navExtIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_ext" />

                        <TextView
                            android:id="@+id/navExtText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_ext"
                            android:textColor="#FF7A8292"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/navSettingsIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_settings" />

                        <TextView
                            android:id="@+id/navSettingsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nav_settings"
                            android:textColor="#FF7A8292"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 顶部小胶囊：唯一允许出现在对话页上的 App 元素（§4.5 / §4.6）。
         elevation 要压过加载页（11dp），否则引擎没就绪时看不到它。 -->
    <LinearLayout
        android:id="@+id/capsule"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_pill"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/capsuleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="260dp"
            android:singleLine="true"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 加载页：引擎侧没就绪时盖住网页；网页首帧渲染完成后淡出 -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_page"
        android:clickable="true"
        android:elevation="11dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 应用图标居中（用真正的启动图标；自适应图标 API 26+ 可直接放进 ImageView） -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <!-- 图标正下方的启动信息（只说"在干什么"，不出现端口/域名） -->
        <TextView
            android:id="@+id/loadingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/loadingSpinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/accent" />

        <!-- 安装/解压进度：null 时转圈，有值时走确定性百分比 -->
        <ProgressBar
            android:id="@+id/installProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressBackgroundTint="#FFE7E9EF"
            android:progressTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
